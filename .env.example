# Copy to .env.local and fill in. Never commit real values.

# Public base URL, used for canonical links, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://pimwork.nl

# Optional: enables the live AI answers in the terminal (server-side only).
# Without it the terminal answers from the site content itself, labelled as such.
ANTHROPIC_API_KEY=

# Contact form delivery through Resend (server-side only, never NEXT_PUBLIC_).
# RESEND_API_KEY: an API key from resend.com for the verified domain pimwork.nl.
# CONTACT_TO_EMAIL: the address where messages arrive.
# CONTACT_FROM_EMAIL: the sender on the verified domain, for example: PimWork <contact@pimwork.nl>
# Without these the form still validates, but sending answers 500 and the server log names what is missing.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
