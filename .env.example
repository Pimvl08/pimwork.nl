# Copy to .env.local and fill in. Never commit real values.

# Public base URL, used for canonical links, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://pimwork.nl

# Optional: enables the live AI answers in the terminal (server-side only).
# Without it the terminal answers from the site content itself, labelled as such.
ANTHROPIC_API_KEY=

# Optional: enables real delivery of the contact form through Resend.
# Without both values the form validates input and says honestly that mail is not configured.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
